        <mxCell id="Lb6wYR-V37zxcw0Czo2z-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDDE1;strokeColor=#D85B6A;strokeWidth=3;fontSize=15;" value="本次随机&lt;br&gt;&lt;b&gt;Kalman 增益 Kₖ⁽ʲ⁾&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="155" x="1399" y="786" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FAF8FF;strokeColor=#A995D8;dashed=1;fontSize=13;" value="&lt;b&gt;一次调用 kf_net 的随机性&lt;/b&gt;&lt;br&gt;基础权重 W 固定共享；两个模块各自重新采样 Concrete 掩码。&lt;br&gt;掩码随机化的是层输入/隐藏激活，从等效角度形成随机子网络。" vertex="1">
          <mxGeometry height="92" width="585" x="769" y="796" as="geometry" />
