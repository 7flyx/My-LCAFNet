        <mxCell id="SgrioebMOh-3QlOuM7lC-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color:#ffffff;color:#080808&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# [&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;核心&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;以下先用部分已知的状态空间模型&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; f&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;、&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;g &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;做预测，再让神经网络根据四类创新量学习&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; Kalman &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;增益。&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#000000;&quot;&gt;x_last &lt;/span&gt;= &lt;span style=&quot;color:#94558d;&quot;&gt;self&lt;/span&gt;.state_post &lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;上一时刻的 估计值&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#000000;&quot;&gt;x_predict &lt;/span&gt;= &lt;span style=&quot;color:#94558d;&quot;&gt;self&lt;/span&gt;.GSSModel.f(&lt;span style=&quot;color:#000000;&quot;&gt;x_last&lt;/span&gt;) &lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;当前时刻的 先验估计值&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="560" x="-560" y="170.57" as="geometry" />
        </mxCell>
        <mxCell id="SgrioebMOh-3QlOuM7lC-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color:#ffffff;color:#080808&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#000000;&quot;&gt;y_predict &lt;/span&gt;= &lt;span style=&quot;color:#94558d;&quot;&gt;self&lt;/span&gt;.GSSModel.g(&lt;span style=&quot;color:#000000;&quot;&gt;x_predict&lt;/span&gt;) &lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;当前时刻&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; y&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;的估计值&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="480" x="-560" y="240" as="geometry" />
        </mxCell>
