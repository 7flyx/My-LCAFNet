        <mxCell id="cxnF5ro4i54K7u0uLYNZ-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); color: rgb(8, 8, 8);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt;# [&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;核心&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;每调用一次&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt; kf_net&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;，两个&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt; ConcreteDropout &lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;模块都会重新采样掩码，&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt;# &lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;因而给出本次随机前向传播对应的&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt; Kalman &lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;增益&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic;&quot;&gt; K_t^(j)&lt;/span&gt;&lt;span style=&quot;color: rgb(140, 140, 140); font-style: italic; font-family: Menlo-Regular, monospace;&quot;&gt;。&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;K_gain&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;regularization &lt;/span&gt;= &lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.kf_net(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;state_inno&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;residual&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;diff_state&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;diff_obs&lt;/span&gt;)&lt;br&gt;&lt;br&gt;kf_net 函数 就进入 dnn.py 的 DNN_KalmanNet_GSS类的 forward()&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="560" x="1130" y="210" as="geometry" />
        </mxCell>
