        <mxCell id="Lb6wYR-V37zxcw0Czo2z-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CE;strokeColor=#D9A928;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Concrete Dropout 2&lt;/b&gt;&lt;br&gt;p₂：模块共享标量&lt;br&gt;掩码逐 GRU_out 元素采样" vertex="1">
          <mxGeometry height="98" width="160" x="1287" y="556" as="geometry" />
