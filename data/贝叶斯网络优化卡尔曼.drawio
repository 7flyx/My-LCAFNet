        <mxCell id="Lb6wYR-V37zxcw0Czo2z-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7E3;strokeColor=#68A84F;strokeWidth=2;fontSize=14;" value="&lt;b&gt;l1&lt;/b&gt;&lt;br&gt;Linear&lt;br&gt;+ ReLU" vertex="1">
