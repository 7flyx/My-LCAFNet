        <mxCell id="Lb6wYR-V37zxcw0Czo2z-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#DCE9FF;strokeColor=#5B8DEF;strokeWidth=2;fontSize=14;verticalAlign=middle;" value="&lt;b&gt;四类增益网络输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;① state_inno：上次后验 − 上次预测&lt;br&gt;② residual：yₖ − ŷₖ|ₖ₋₁&lt;br&gt;③ diff_state：相邻后验状态差&lt;br&gt;④ diff_obs：相邻观测差" vertex="1">
