        <UserObject label="&lt;div style=&quot;background-color:#ffffff;color:#080808&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# [&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;概率&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;沿最后的&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; MC &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;维求均值，近似后验预测期望&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; E[x_hat]&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;，作为 最终状态估计。&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#000000;&quot;&gt;x_hat&lt;/span&gt;[&lt;span style=&quot;color:#000000;&quot;&gt;i&lt;/span&gt;] = torch.mean(&lt;span style=&quot;color:#000000;&quot;&gt;x_hat_temp&lt;/span&gt;[&lt;span style=&quot;color:#000000;&quot;&gt;i&lt;/span&gt;].clone(), &lt;span style=&quot;color:#660099;&quot;&gt;dim&lt;/span&gt;=-&lt;span style=&quot;color:#1750eb;&quot;&gt;1&lt;/span&gt;)&lt;/pre&gt;&lt;/div&gt;" link="&lt;div style=&quot;background-color:#ffffff;color:#080808&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;# [&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;概率&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;沿最后的&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; MC &lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;维求均值，近似后验预测期望&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;&quot;&gt; E[x_hat]&lt;/span&gt;&lt;span style=&quot;color:#8c8c8c;font-style:italic;font-family:&#39;Menlo-Regular&#39;,monospace;&quot;&gt;，作为 最终状态估计。&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#000000;&quot;&gt;x_hat&lt;/span&gt;[&lt;span style=&quot;color:#000000;&quot;&gt;i&lt;/span&gt;] = torch.mean(&lt;span style=&quot;color:#000000;&quot;&gt;x_hat_temp&lt;/span&gt;[&lt;span style=&quot;color:#000000;&quot;&gt;i&lt;/span&gt;].clone(), &lt;span style=&quot;color:#660099;&quot;&gt;dim&lt;/span&gt;=-&lt;span style=&quot;color:#1750eb;&quot;&gt;1&lt;/span&gt;)&lt;/pre&gt;&lt;/div&gt;" id="mugb4C7OIwAR_cT8KM-D-56">
