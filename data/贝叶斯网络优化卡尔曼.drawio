        <mxCell id="cxnF5ro4i54K7u0uLYNZ-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;l1层&lt;br&gt;特征维度&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); color: rgb(8, 8, 8);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.input_dim = (&lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.x_dim * &lt;span style=&quot;color: rgb(23, 80, 235);&quot;&gt;2&lt;/span&gt;) + (&lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.y_dim * &lt;span style=&quot;color: rgb(23, 80, 235);&quot;&gt;2&lt;/span&gt;)&lt;br&gt;&lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.output_dim = &lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.x_dim * &lt;span style=&quot;color: rgb(148, 85, 141);&quot;&gt;self&lt;/span&gt;.y_dim&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
