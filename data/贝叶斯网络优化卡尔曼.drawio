        <mxCell id="Lb6wYR-V37zxcw0Czo2z-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D9A928;dashed=1;fontColor=#705711;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;第二个 Dropout 位于 GRU_out 与整个 l2 之间；不是放在最终 K 之后，也不是插在 l2 内每个 Linear 之间。&lt;/font&gt;" vertex="1">
          <mxGeometry height="54" width="785" x="769" y="906" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D85B6A;strokeWidth=2;fontSize=14;" value="预测状态&lt;br&gt;&lt;b&gt;x̂ₖ|ₖ₋₁&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="115" x="1619" y="546" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D85B6A;strokeWidth=2;fontSize=13;" value="观测残差&lt;br&gt;&lt;b&gt;rₖ = yₖ − ŷₖ|ₖ₋₁&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="110" x="1744" y="546" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDDE1;strokeColor=#D85B6A;strokeWidth=3;fontSize=17;" value="&lt;b&gt;x̂ₖ|ₖ⁽ʲ⁾ = x̂ₖ|ₖ₋₁ + Kₖ⁽ʲ⁾ rₖ&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="235" x="1619" y="666" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D85B6A;strokeWidth=2;fontSize=14;" value="一次完整观测序列递推&lt;br&gt;得到一条状态轨迹&lt;br&gt;&lt;b&gt;X̂⁽ʲ⁾ = [x̂₁⁽ʲ⁾,…,x̂T⁽ʲ⁾]&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="235" x="1619" y="801" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F8;strokeColor=#D98A94;dashed=1;fontColor=#7A3440;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;一次 filtering 只产生一个随机状态样本，不会直接产生协方差。&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="235" x="1619" y="911" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-31" parent="1" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=16;fontColor=#334155;" value="&lt;b&gt;④ Monte Carlo 推理：预测分布与不确定性&lt;/b&gt;" vertex="1">
          <mxGeometry height="225" width="1600" x="274" y="1011" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=14;" value="同一观测序列&lt;br&gt;&lt;b&gt;Y = [y₁,…,yT]&lt;/b&gt;" vertex="1">
          <mxGeometry height="72" width="165" x="309" y="1081" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CE;strokeColor=#D9A928;strokeWidth=2;fontSize=14;" value="重复 &lt;b&gt;J = 20&lt;/b&gt; 次（默认配置）&lt;br&gt;每个时间步重新采样&lt;br&gt;M₁⁽ʲ⁾、M₂⁽ʲ⁾" vertex="1">
          <mxGeometry height="92" width="210" x="534" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DFFF;strokeColor=#8B6FD6;strokeWidth=2;fontSize=14;" value="共享基础权重 W 的&lt;br&gt;J 个随机有效网络" vertex="1">
          <mxGeometry height="72" width="185" x="804" y="1081" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#8B6FD6;strokeWidth=2;fontSize=14;" value="J 条随机状态轨迹&lt;br&gt;&lt;b&gt;X̂⁽¹⁾, X̂⁽²⁾, …, X̂⁽ᴶ⁾&lt;/b&gt;" vertex="1">
          <mxGeometry height="72" width="205" x="1049" y="1081" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7E3;strokeColor=#68A84F;strokeWidth=3;fontSize=14;" value="&lt;b&gt;样本均值&lt;/b&gt;&lt;br&gt;x̄ₖ = meanⱼ[x̂ₖ⁽ʲ⁾]&lt;br&gt;最终状态估计" vertex="1">
          <mxGeometry height="102" width="205" x="1319" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDDE1;strokeColor=#D85B6A;strokeWidth=3;fontSize=14;" value="&lt;b&gt;逐分量样本方差&lt;/b&gt;&lt;br&gt;diag(P̂ₖ) = varⱼ[x̂ₖ⁽ʲ⁾]&lt;br&gt;预测不确定性" vertex="1">
          <mxGeometry height="102" width="240" x="1589" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F8;strokeColor=#D85B6A;dashed=1;fontSize=12;fontColor=#7A3440;" value="&lt;b&gt;重要：&lt;/b&gt;源码用 torch.var 沿 MC 维逐状态分量计算方差，只得到协方差矩阵对角线 diag(P̂)，不包含状态分量之间的非对角协方差。" vertex="1">
          <mxGeometry height="38" width="570" x="1259" y="1181" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-39" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;horizontal=1;fillColor=#F7FAF5;strokeColor=#68A84F;strokeWidth=2;fontSize=16;fontColor=#356529;" value="&lt;b&gt;⑤ 训练摘要（联合优化）&lt;/b&gt;" vertex="1">
          <mxGeometry height="180" width="1600" x="274" y="1261" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#68A84F;strokeWidth=2;fontSize=14;align=left;spacingLeft=14;" value="&lt;b&gt;联合损失&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;L = (1−β) · 状态 MSE + β · |平方误差 − MC 方差| + Concrete 正则&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;β 随训练进度线性增大：前期侧重状态均值，后期加强方差校准&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="815" x="309" y="1321" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#68A84F;strokeWidth=2;fontSize=14;align=left;spacingLeft=14;" value="&lt;b&gt;反向传播共同更新&lt;/b&gt;&lt;br&gt;• l1、GRU、l2 的基础权重 W 与偏置&lt;br&gt;• p₁_logit、p₂_logit → sigmoid → p₁、p₂" vertex="1">
          <mxGeometry height="88" width="660" x="1169" y="1321" as="geometry" />
        </mxCell>
        <mxCell id="Lb6wYR-V37zxcw0Czo2z-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;fontColor=#334155;" value="&lt;b&gt;颜色图例&lt;/b&gt;　蓝：状态空间模型/特征　　紫：KalmanNet/GRU　　黄：Concrete Dropout　　绿：确定性层/均值　　红：增益/状态更新/方差　　实线：前向数据流　　虚线：记忆或重复采样" vertex="1">
          <mxGeometry height="50" width="1600" x="274" y="1461" as="geometry" />
        </mxCell>
