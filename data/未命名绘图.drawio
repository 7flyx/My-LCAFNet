          </mxGeometry>
        </mxCell>
        <mxCell id="c22" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c11" value="ŷ_CV⁽ʲ⁾, K_CV">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" edge="1" parent="1" source="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" target="c11" value="ŷ_CA⁽ʲ⁾, K_CA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c12" value="c(t)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1210" y="146" />
              <mxPoint x="1210" y="450" />
              <mxPoint x="1440" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" edge="1" parent="1" source="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c12" value="ℓ_i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c26" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" target="c13" value="X_CV(t|t)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1015" y="420" />
              <mxPoint x="1015" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c27" edge="1" parent="1" source="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" target="c13" value="X_CA(t|t)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" edge="1" parent="1" source="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" target="c13" value="μ(t)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c29" edge="1" parent="1" source="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;带到下一时刻 t+1 的量&lt;/b&gt;&lt;br&gt;• μ(t) → 下一步的 ① 马尔可夫预测&lt;br&gt;• 两个专家的后验样本 X_i(t|t)（未交互的原始后验）→ 下一步的 ② 交互&lt;br&gt;• 每条链的 GRU 隐状态 h、特征历史（x 的上一后验 / 上一先验、上一量测）→ 下一步的 ③&lt;br&gt;• 上一步的平均增益 K̄_i（只在 s_key = gain 时用）、新息平方历史（只在 s_key = emp 时用）→ 下一步的 ④&lt;br&gt;&lt;br&gt;&lt;b&gt;两个专家只在三处耦合&lt;/b&gt;：② 交互（均值互相拉近）、⑤ 模式概率（竞争谁更能解释 y_t）、⑥ 融合。&lt;br&gt;其余部分（网络、GRU、运动模型）各自独立。" vertex="1">
          <mxGeometry height="270" width="760" x="40" y="690" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 样本云交互" id="-ZvYyX9JXs7nDLvr1emQ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;② 样本云交互（mix = &quot;mean&quot;，论文配置）：每个专家的 J 个样本整体平移，离散度不变&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1500" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入：混合概率&lt;/b&gt;&lt;br&gt;μ(t−1)：(B, D, M)&lt;br&gt;Π：(M, M)&lt;br&gt;→ c(t)：(B, D, M)&lt;br&gt;→ mixp[b,d,k,i] = μ_{k|i}：(B, D, M, M)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:125-127&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入：两团样本云&lt;/b&gt;&lt;br&gt;X_CV：(B, J, 4) = st.x_post.view(B,J,−1)&lt;br&gt;X_CA：(B, J, 6)&lt;br&gt;公共子状态 common_i = X_i[..., :4]&lt;br&gt;顺序 [p_x, p_y, v_x, v_y]&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:129-131&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="330" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;步骤 1：每个专家的样本均值&lt;/b&gt;&lt;br&gt;m_k = (1/J) Σ_j common_k⁽ʲ⁾ ：(B, 4)&lt;br&gt;means = stack_k m_k：(B, 4, M)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:138&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="430" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;步骤 2：混合均值&lt;/b&gt;&lt;br&gt;对接收方 i：权重 w = mixp[:, axis_of, :, i]：(B, 4, M)&lt;br&gt;（axis_of = [0,1,0,1] 把 4 个分量映射到 x/y 轴，&lt;br&gt;joint 时两轴相同）&lt;br&gt;m̄_i = Σ_k w_k m_k：(B, 4)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:134-139&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="400" x="430" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;步骤 3：整体平移&lt;/b&gt;&lt;br&gt;common_i⁽ʲ⁾ ← common_i⁽ʲ⁾ + (m̄_i − m_i)　对所有 j&lt;br&gt;同一个平移向量 → 样本协方差不变&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:140&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="430" y="450" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;步骤 4：写回&lt;/b&gt;&lt;br&gt;X_i[..., :4] = 平移后的 common_i&lt;br&gt;CA 的 [a_x, a_y] 保持原值&lt;br&gt;st.x_post = X_i.reshape(N, m_i)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:151-155&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="400" x="430" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;X̃_CV：(B, J, 4) → CV 专家的 BKN 一步&lt;br&gt;X̃_CA：(B, J, 6) → CA 专家的 BKN 一步&lt;br&gt;（作为 x_{t−1|t−1} 输入第 4 页）" vertex="1">
          <mxGeometry height="120" width="330" x="900" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c9" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c5" value="μ_{k|i}">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" target="c4" value="common_k">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="321" />
              <mxPoint x="400" y="158" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c11" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c5" value="m_k">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c6" value="m̄_i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c6" value="common_i">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="205" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c14" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;数值例子&lt;/b&gt;（μ(t−1) = [0.9, 0.1]，stay = 0.98）&lt;br&gt;c_CV = 0.98×0.9 + 0.02×0.1 = 0.884，μ_{CA|CV} = 0.002/0.884 ≈ 0.002：CV 专家几乎不动&lt;br&gt;c_CA = 0.02×0.9 + 0.98×0.1 = 0.116，μ_{CV|CA} = 0.018/0.116 ≈ 0.155：CA 专家被拉向 CV 约 15.5%&lt;br&gt;&lt;br&gt;&lt;b&gt;结论&lt;/b&gt;：概率小的专家被概率大的专家拉过去，和经典 IMM 相同。" vertex="1">
          <mxGeometry height="250" width="660" x="900" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;和经典 IMM 的区别&lt;/b&gt;&lt;br&gt;• 经典 IMM 同时混合均值和协方差：P̄_i = Σ_k μ_{k|i} [P_k + (m_k − m̄_i)(·)ᵀ]&lt;br&gt;• 这里协方差由样本离散度承载，只平移均值，不改离散度、不改 GRU 隐状态&lt;br&gt;&lt;br&gt;&lt;b&gt;消融里的另外两种&lt;/b&gt;&lt;br&gt;• mix = &quot;sample&quot;：每个样本 j 按 μ_{k|i} 抽一个来源专家，直接拷贝其样本（均值和离散度一起混合）&lt;br&gt;• mix = &quot;none&quot;：不交互，两个专家各自独立" vertex="1">
          <mxGeometry height="230" width="660" x="900" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;审核要点&lt;/b&gt;&lt;br&gt;1. mixp 的下标顺序是 [b, d, k(来源), i(接收)]，每个 i 的 Σ_k mixp = 1（c 在分母）。&lt;br&gt;2. 平移量用的是“混合均值 − 自己的均值”，不是“混合均值 − 每个样本”，所以样本间相对位置不变（可检查交互前后 X.var(1) 不变）。&lt;br&gt;3. 只改公共子状态 [:4]；CA 专家的加速度不动。注意状态布局是 BKN 布局 [p_x,p_y,v_x,v_y,(a_x,a_y)]，不是每轴 [p,v,a]。&lt;br&gt;4. 交互改的是 st.x_post（下一步网络的输入状态）；BKNStepper 内部保存的特征历史（上一后验 / 上一先验）不随之改变。" vertex="1">
          <mxGeometry height="170" width="1520" x="40" y="780" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 BKN 内部（一个专家、一步）" id="Yb1f_w8I05z9v-14UQsN">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;BKN 一步：线性预测 + 网络给增益 K + 残差更新（bkn/filter.py: BKNStepper.step，bkn/net.py: KNetV1Vec）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1600" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;x̃_{t−1|t−1}：(N, m)（交互后）&lt;br&gt;y_t：(N, 2)（每条链同一个量测）&lt;br&gt;h：(L, N, H)" vertex="1">
          <mxGeometry height="110" width="300" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;线性预测&lt;/b&gt;&lt;br&gt;x_pred = F x̃：(N, m)&lt;br&gt;ŷ = H x_pred：(N, 2)&lt;br&gt;F：CV 或 CA 运动模型（dt = 0.1）&lt;br&gt;H 取出两个位置&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;filter.py:42,50 · expert.py: model_matrices&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;4 个输入特征（官方 BKN 顺序）&lt;/b&gt;&lt;br&gt;F1 = post_past − pred_past&lt;br&gt;　 = x̃_{t−2|t−2} − x_{t−1|t−2} = (I − F) x̃_{t−2|t−2}&lt;br&gt;F2 = y_t − ŷ（本步新息）&lt;br&gt;F3 = x̃_{t−1|t−1} − x̃_{t−2|t−2}（后验变化）&lt;br&gt;F4 = y_t − y_{t−1}（量测差分）&lt;br&gt;拼接 feat：(N, 2m + 2n)&lt;br&gt;t = 1 时历史就地初始化：F3 = F4 = 0，F1 = x₀ − F x₀&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;filter.py:43-55&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="420" x="400" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;ConcreteDropout 1（输入层）&lt;/b&gt;&lt;br&gt;feat / feat_scale（默认全 1）&lt;br&gt;u ~ U(0,1) 每个元素&lt;br&gt;keep = 1 − sigmoid((logit p + logit u)/0.1)&lt;br&gt;x · keep / (1 − p)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;net.py:38-46, 93&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="880" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="Linear(2m+2n → H1) + ReLU&lt;br&gt;H1 = (m+n)·80" vertex="1">
          <mxGeometry height="70" width="360" x="880" y="220" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="GRU，L = 2 层，隐维 H = 4(m² + n²)&lt;br&gt;序列长度 1（逐步调用），h 每条链各自保存&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;net.py:74, 94&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="880" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="ConcreteDropout 2（GRU 输出上，另一组随机数）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;net.py:95&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="880" y="440" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="Linear(H → H2) + ReLU + Linear(H2 → m·n)&lt;br&gt;H2 = 4·m·n&lt;br&gt;reshape → K：(N, m, 2)" vertex="1">
          <mxGeometry height="90" width="360" x="880" y="540" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;更新&lt;/b&gt;&lt;br&gt;x_post = x_pred + K (y_t − ŷ)：(N, m)&lt;br&gt;存 post_past ← x̃_{t−1|t−1}，pred_past ← x_pred，obs_past ← y_t（detach）&lt;br&gt;x_post ← x_new（detach，跨步不反传状态）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;filter.py:65-75&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="400" y="440" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;x_new：(N, m) 后验样本 → view(B, J, m)&lt;br&gt;ŷ：(N, 2) 先验量测预测 → 似然&lt;br&gt;K：(N, m, 2) → s_key=gain 时用" vertex="1">
          <mxGeometry height="110" width="420" x="400" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c12" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c4" value="x_pred, ŷ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" target="c4" value="x̃, y_t">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c5" value="feat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c8" value="GRU 输出">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="c10" value="K">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c10" value="x_pred, ŷ">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c22" edge="1" parent="1" source="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c2" value="h 留给下一步">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="365" />
              <mxPoint x="1270" y="60" />
              <mxPoint x="190" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;网络尺寸&lt;/b&gt;（n = 2）&lt;br&gt;&lt;br&gt;&lt;b&gt;CV 专家&lt;/b&gt;（m = 4）&lt;br&gt;输入 12 → H1 480 → GRU 2×80 → H2 32 → 输出 8（K 为 4×2）&lt;br&gt;&lt;br&gt;&lt;b&gt;CA 专家&lt;/b&gt;（m = 6）&lt;br&gt;输入 16 → H1 640 → GRU 2×160 → H2 48 → 输出 12（K 为 6×2）&lt;br&gt;&lt;br&gt;同一个专家只有一套权重和两个 dropout 概率 p；J 条链共享权重，随机性只来自每步重新采样的 dropout 噪声。" vertex="1">
          <mxGeometry height="300" width="380" x="1290" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;训练&lt;/b&gt;（scripts/train_bkn_vec.py，enhanced 配方）&lt;br&gt;• 5000 次迭代，batch 32，训练时 J = 10，学习率 1e-3 → 1e-5（余弦）&lt;br&gt;• 损失 bkn_loss：(1−β)·mean(e²) + β·Σ|e² − Var_j| + B(T−1)·dropout 正则，β = 0.01&lt;br&gt;• 只用 t ≥ 1；状态跨步 detach，GRU 隐状态保留 BPTT&lt;br&gt;• 推理（评估）时 J = 20，dropout 仍然采样（MC dropout）" vertex="1">
          <mxGeometry height="320" width="380" x="1290" y="410" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;审核要点&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;F1 的实际含义&lt;/b&gt;：代码完全照搬官方 BKN（GSSFiltering/filtering.py:190, 208-209）。在第 t 步时 post_past = x̃_{t−2|t−2}、pred_past = x_{t−1|t−2} = F x̃_{t−2|t−2}，所以 F1 = (I − F) x̃_{t−2|t−2}；对 CV 就是 [−dt·v_x, −dt·v_y, 0, 0]（两步前的速度乘 −dt）。filter.py:52 的注释和旧版《数据流说明》写的 “x_{t−1|t−1} − x_{t−1|t−2}（上一步更新量）” 与代码不符；这是官方实现的特点，不是移植错误，但汇报时不要说成 KalmanNet 论文里的“前向更新差”。&lt;br&gt;2. dropout 在 eval()/no_grad() 下照样采样（net.py:43 没有 training 分支），这正是 MC dropout 需要的。&lt;br&gt;3. 每条链有自己的 x_post 和 h；J 条链从同一个 x₀、同一个 hn_init 出发，之后靠 dropout 分化。&lt;br&gt;4. 状态布局是 [p_x, p_y, v_x, v_y, (a_x, a_y)]；H 只取前两维；协方差从 J 个样本算，网络本身不输出协方差。&lt;br&gt;5. 交互只改 x_post，不改 post_past / pred_past，所以 F1 用的是上一步交互后的后验，F3 = 本步交互后后验 − 上一步交互后后验。" vertex="1">
          <mxGeometry height="300" width="1630" x="40" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 马尔可夫与模式概率更新" id="_pDLTEIP7rkR12V6crcz">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;① 马尔可夫预测 + ④ 新息似然 + ⑤ 模式概率更新（mm_runner.py:125-127, 159-220）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1500" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;马尔可夫预测&lt;/b&gt;&lt;br&gt;Π = [[0.98, 0.02], [0.02, 0.98]]（stay 在验证集上选）&lt;br&gt;Π_ki：上一步模式 k → 这一步模式 i&lt;br&gt;c_i(t) = Σ_k Π_ki μ_k(t−1)&lt;br&gt;（看到 y_t 之前的预测概率）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:98-100, 125&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="360" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;新息&lt;/b&gt;&lt;br&gt;专家 i 的 J 个 ŷ_i⁽ʲ⁾：(B, J, 2)&lt;br&gt;ȳ_i = mean_j ŷ_i⁽ʲ⁾&lt;br&gt;ν_i = y_t − ȳ_i：(B, 2)&lt;br&gt;（用交互后状态的先验预测）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:164-165&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="420" x="460" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;新息方差 Ŝ_i,d（s_key 五选一）&lt;/b&gt;&lt;br&gt;&lt;b&gt;nom&lt;/b&gt;：S_nom（专家验证集上 mean ν²，常数）&lt;br&gt;&lt;b&gt;nom_t&lt;/b&gt;：S_rob = (median|ν|/0.6745)²，配 Student-t&lt;br&gt;&lt;b&gt;ens&lt;/b&gt;：Var_j ŷ_i⁽ʲ⁾ + r²&lt;br&gt;&lt;b&gt;gain&lt;/b&gt;：(I − sym(H K̄_i(t−1))_clip)⁻¹ r²I 的对角（上一步平均增益反推）&lt;br&gt;&lt;b&gt;emp&lt;/b&gt;：最近 10 步 ν² 的均值 + 10⁻³（不足 10 步用 S_nom）&lt;br&gt;全部截断 Ŝ ≥ 10⁻⁶&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:168-193&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="420" x="460" y="290" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;对数似然&lt;/b&gt;&lt;br&gt;高斯：ℓ_i,d = −(ν²/Ŝ + ln Ŝ) / (2τ)&lt;br&gt;Student-t（f = 4）：&lt;br&gt;ℓ_i,d = [−½ ln Ŝ − (f+1)/2 · ln(1 + ν²/(fŜ))] / τ&lt;br&gt;温度 τ ∈ {1, 2, 4}（验证集选）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:196-200&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="420" x="940" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;两轴耦合&lt;/b&gt;&lt;br&gt;coupling = joint：ℓ_i = ℓ_i,x + ℓ_i,y（两轴共用一个 μ）&lt;br&gt;coupling = axis：每轴各自更新&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:215-216&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="420" x="940" y="310" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;贝叶斯更新（mode_rule = imm）&lt;/b&gt;&lt;br&gt;log w_i = ln c_i + ℓ_i → softmax&lt;br&gt;μ_i = max(w_i, 10⁻³) / Σ_k max(w_k, 10⁻³)&lt;br&gt;（下限保证切换后能“回得来”）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:217-219&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="420" x="940" y="450" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;μ(t)：(B, D, M) → ⑥ 融合权重；也是下一步 ① 的 μ(t−1)" vertex="1">
          <mxGeometry height="90" width="420" x="940" y="640" as="geometry" />
        </mxCell>
        <mxCell id="c9" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c7" value="c(t)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c10" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c4" value="ν_i（emp 用历史）">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c5" value="ν_i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" target="c5" value="Ŝ_i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;对比：注意力规则&lt;/b&gt;（消融，mode_rule = att，参考 Mari &amp; Snidaro 2026）&lt;br&gt;μ_i = softmax_i( −Σ_d ν_i,d² / Ŝ_i,d )：只看当前一步，没有马尔可夫先验、没有 ln Ŝ 项&lt;br&gt;反应更快但更容易抖动；本工作结果中它的校准更差。&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:206-210&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="820" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;审核要点&lt;/b&gt;&lt;br&gt;1. ŷ 来自交互后的状态（ŷ = H F x̃），所以似然评价的是“交互后的预测”，与经典 IMM 用混合后状态做预测一致。&lt;br&gt;2. gain 取法用的是上一步的 K̄（Kbar_prev 在本步计算 S 之后才更新为本步 K），因此是因果的；第 1 步 S = r²。&lt;br&gt;3. 两轴 joint 时 ll 先相加再 expand，所以 μ 在两轴上相同；μ 的形状仍是 (B, D, M)。&lt;br&gt;4. softmax 里加的是 ln c（c 截断在 1e-30 以上），等价于 c·exp(ℓ) 归一化；之后的 10⁻³ 下限会使 μ 不完全等于贝叶斯后验。" vertex="1">
          <mxGeometry height="180" width="1520" x="40" y="830" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6 矩匹配融合" id="hD57cltmT0FhZBhpwMfq">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;⑥ 从样本云到每轴 [p,v] 高斯，再按 μ 矩匹配（mm_runner.py:222-246，pv_mean_cov:51-70）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1500" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;X_i(t|t)：(B, J, m_i) 后验样本&lt;br&gt;μ(t)：(B, D, M)&lt;br&gt;标定量：σ_i,p, σ_i,v（var_scale），γ_i（shrink）" vertex="1">
          <mxGeometry height="120" width="330" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;样本均值与样本协方差&lt;/b&gt;&lt;br&gt;z_i,d⁽ʲ⁾ = [p_d, v_d]⁽ʲ⁾（x 轴取 [0,2]，y 轴取 [1,3]）&lt;br&gt;m_i,d = mean_j z：(B, D, 2)&lt;br&gt;C_i,d = Σ_j (z − m)(z − m)ᵀ / (J − 1)：(B, D, 2, 2)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;pv_mean_cov:57-61&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="430" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;方差校准与相关收缩&lt;/b&gt;&lt;br&gt;C̃ = Λ^{1/2} C Λ^{1/2}，Λ = diag(σ_p, σ_v)&lt;br&gt;（对角 ×σ，非对角 ×√(σ_p σ_v)）&lt;br&gt;非对角再乘 (1 − γ_i)：J = 20 个样本估的相关系数噪声大&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;pv_mean_cov:62-69 · mm_runner.py:229-233&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="430" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;矩匹配&lt;/b&gt;&lt;br&gt;x̂_d = Σ_i μ_i m_i,d&lt;br&gt;P_d = Σ_i μ_i [ C̃_i,d + (m_i,d − x̂_d)(m_i,d − x̂_d)ᵀ ]&lt;br&gt;　第一项：专家自身的不确定性（样本离散度）&lt;br&gt;　第二项：专家之间的分歧（机动开始时变大）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:236-244&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="430" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;统一输出校准（所有方法相同）&lt;/b&gt;&lt;br&gt;P ← K^{1/2} P K^{1/2}，K = diag(κ_p, κ_v)&lt;br&gt;κ_c = mean(e_c² / P_cc)（目标场景验证集）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval_fusion.py: cov_scale / apply_cov_scale&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="420" x="430" y="660" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;MM-BKN 最终输出&lt;/b&gt;&lt;br&gt;x̂(t)：(B, D, 2)&lt;br&gt;P(t)：(B, D, 2, 2)（两轴之间块对角）" vertex="1">
          <mxGeometry height="110" width="400" x="920" y="660" as="geometry" />
        </mxCell>
        <mxCell id="c8" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c5" value="μ(t)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="205" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c12" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;几个副产品（同一组样本）&lt;/b&gt;&lt;br&gt;• P_full0：不收缩的完整协方差（消融“cov=full, no shrinkage”）&lt;br&gt;• P_diag：只保留方差（消融“cov=diag”，即官方 BKN 只给对角方差）&lt;br&gt;三者用同一组样本、同一组 μ，所以消融差异不混入 MC 噪声。&lt;br&gt;&lt;br&gt;&lt;b&gt;t = 0&lt;/b&gt;：x̂ 取第一个专家的初始状态，P = I，不计入任何指标。" vertex="1">
          <mxGeometry height="300" width="640" x="920" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;审核要点&lt;/b&gt;&lt;br&gt;1. 样本协方差除以 J−1（无偏），与 torch.var 一致。&lt;br&gt;2. 校准系数 σ 来自专家自己的验证集（Expert.calibrate），而 κ 来自目标场景验证集，两层校准是叠加的。&lt;br&gt;3. 分歧项用的是融合后的 x̂_d，不是每个专家自己的均值。&lt;br&gt;4. P 只在每轴内是 2×2，两轴之间没有交叉项（块对角）。" vertex="1">
          <mxGeometry height="210" width="640" x="920" y="410" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7 混合层（MM-BKN + 经典 IMM）" id="iyWoxJluwACcVfOaYejg">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;混合层：在 MM-BKN 输出之后加一层（fusion/hybrid.py: build_rows / apply_layer）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1600" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入：MM-BKN&lt;/b&gt;&lt;br&gt;x₁, P₁（未做最终校准）, μ&lt;br&gt;验证集与测试集各一份" vertex="1">
          <mxGeometry height="120" width="330" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入：经典合作方&lt;/b&gt;&lt;br&gt;全部已调好的经典方法在验证集上的输出&lt;br&gt;选验证集位置 MSE 最小者 → x₂, P₂&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;build_rows: val_db / min&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="330" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;各自先校准&lt;/b&gt;&lt;br&gt;k₁ = cov_scale(x₁, P₁)，k₂ = cov_scale(x₂, P₂)（验证集）&lt;br&gt;P₁ ← k₁ 校准，P₂ ← k₂ 校准&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hybrid.py: _components&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="430" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;固定权重（验证集最小二乘）&lt;/b&gt;&lt;br&gt;w = ⟨truth − x₂, x₁ − x₂⟩ / ‖x₁ − x₂‖²，截断到 [0,1]&lt;br&gt;位置、速度各一个，两轴共用&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hybrid.py: fit_fixed_w&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="430" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;GBM 逐步权重&lt;/b&gt;&lt;br&gt;特征：两者最近 8 步新息（截断 ±4σ）、logit P(CA)、x₁−x₂、两者协方差对角的对数&lt;br&gt;目标（mse，默认）：未截断的 w* = (truth − x₂)/(x₁ − x₂)，样本权重 d² = (x₁−x₂)²&lt;br&gt;→ Σ d²(w − w*)² 恰好等于融合平方误差&lt;br&gt;预测后截断到 [0,1]&lt;br&gt;训练数据：新种子轨迹（不与验证 / 测试重叠）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hybrid.py: features / mse_targets / GBMWeights&lt;/font&gt;" vertex="1">
          <mxGeometry height="220" width="400" x="430" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;发散防护（+guard 行）&lt;/b&gt;&lt;br&gt;d² = (x₂ − x₁)ᵀ P₁⁻¹ (x₂ − x₁)&lt;br&gt;d² &gt; 13.8（χ²₂ 的 99.9%）或合作方非有限 → 本步只用 MM-BKN 的 x₁, P₁&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hybrid.py: divergence_guard / blend_cov(keep1)&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="430" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;融合均值与协方差&lt;/b&gt;&lt;br&gt;x = w·x₁ + (1 − w)·x₂（逐分量）&lt;br&gt;mix：wc P₁ + (1−wc) P₂ + wc(1−wc)(x₁−x₂)(x₁−x₂)ᵀ，wc = w 的均值&lt;br&gt;mm+shift：P₁ + (x − x₁)(x − x₁)ᵀ&lt;br&gt;在验证集上按持续段 |ln ANEES| 二选一&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hybrid.py: blend_cov / select_cov&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="400" x="900" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;最终尺度&lt;/b&gt;&lt;br&gt;κ 校准（与所有方法相同，目标场景验证集）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval_fusion.py: cov_scale&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="900" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输出行&lt;/b&gt;&lt;br&gt;MM-BKN+IMM hybrid (fixed w / GBM w / …+guard)&lt;br&gt;以及 cov=mix / cov=mm+shift 子行" vertex="1">
          <mxGeometry height="110" width="400" x="900" y="620" as="geometry" />
        </mxCell>
