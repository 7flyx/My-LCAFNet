  <diagram name="2 单步数据流（时刻 t）" id="-v4b-PHksd4Ghu41hdQX">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;MM-BKN 在时刻 t 的一步（fusion/mm_runner.py: run_mm 的 for t 循环）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1600" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="形状记号：B 条轨迹 × J 个 MC 样本 = N 条链；D = 2 轴；M = 2 个专家；CV 状态 [p_x,p_y,v_x,v_y]（4 维），CA 再加 [a_x,a_y]（6 维）。紫色 = 两专家耦合的步骤；青色 = CV 专家；橙色 = CA 专家；虚线 = 带到下一时刻的量。" vertex="1">
          <mxGeometry height="40" width="1600" x="30" y="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入 1&lt;/b&gt;&lt;br&gt;μ(t−1) : (B, D, M)&lt;br&gt;上一步的模式概率&lt;br&gt;（t=1 时为 [0.5, 0.5]）" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入 2&lt;/b&gt;&lt;br&gt;X_CV(t−1|t−1) : (B, J, 4)&lt;br&gt;X_CA(t−1|t−1) : (B, J, 6)&lt;br&gt;两个专家的后验样本云&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;st.x_post&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="330" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入 3&lt;/b&gt;&lt;br&gt;各专家每条链的 GRU 隐状态 h : (L, N, H)&lt;br&gt;上一步的特征历史&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;BKNStepper 内部&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输入 4&lt;/b&gt;&lt;br&gt;y_t : (B, 2)  本步量测" vertex="1">
          <mxGeometry height="80" width="330" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;① 马尔可夫预测与混合概率&lt;/b&gt;&lt;br&gt;c_i = Σ_k Π_ki μ_k(t−1)&lt;br&gt;μ_{k|i} = Π_ki μ_k / c_i&lt;br&gt;Π: 对角 stay=0.98，非对角 0.02&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:125-127&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="420" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;② 样本云交互（第 3 页）&lt;/b&gt;&lt;br&gt;m_k = 样本均值（公共子状态 [p,v] 4 维）&lt;br&gt;m̄_i = Σ_k μ_{k|i} m_k&lt;br&gt;每个样本 s_i⁽ʲ⁾ += m̄_i − m_i&lt;br&gt;加速度分量、GRU 隐状态不动&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:128-155&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="420" y="260" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;③a CV 专家 BKN 一步（第 4 页）&lt;/b&gt;&lt;br&gt;x_pred = F_CV x̃&lt;br&gt;ŷ = H x_pred&lt;br&gt;4 个特征 → 网络 → K(4×2)&lt;br&gt;x_post = x_pred + K (y_t − ŷ)&lt;br&gt;N 条链各自 dropout&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;bkn/filter.py: BKNStepper.step&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="330" x="850" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;③b CA 专家 BKN 一步&lt;/b&gt;&lt;br&gt;x_pred = F_CA x̃&lt;br&gt;ŷ = H x_pred&lt;br&gt;4 个特征 → 网络 → K(6×2)&lt;br&gt;x_post = x_pred + K (y_t − ŷ)&lt;br&gt;N 条链各自 dropout&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;bkn/filter.py: BKNStepper.step&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="330" x="850" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;④ 新息似然（第 5 页）&lt;/b&gt;&lt;br&gt;ν_i = y_t − mean_j ŷ_i⁽ʲ⁾   (B, 2)&lt;br&gt;Ŝ_i：nom / nom_t / ens / gain / emp 之一&lt;br&gt;ℓ_i,d = −(ν²/Ŝ + ln Ŝ)/(2τ)（或 Student-t）&lt;br&gt;joint：ℓ_i = ℓ_i,x + ℓ_i,y&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:159-200&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="420" x="1230" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;⑤ 模式概率更新（第 5 页）&lt;/b&gt;&lt;br&gt;μ̃_i ∝ c_i · exp(ℓ_i)（softmax）&lt;br&gt;μ_i = max(μ̃_i, 10⁻³) 再归一化&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:204-220&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1230" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;⑥ 矩匹配融合（第 6 页）&lt;/b&gt;&lt;br&gt;每个专家：J 个后验样本 → 每轴 [p,v] 均值 m_i,d 与 2×2 样本协方差 C_i,d → 方差校准 Λ_i^{1/2} C Λ_i^{1/2} → p–v 相关 × (1−γ_i)&lt;br&gt;x̂_d = Σ_i μ_i m_i,d&lt;br&gt;P_d = Σ_i μ_i [ C̃_i,d + (m_i,d − x̂_d)(m_i,d − x̂_d)ᵀ ]&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mm_runner.py:222-246 · pv_mean_cov:51-70&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="800" x="850" y="660" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;x̂(t) : (B, D, 2)　P(t) : (B, D, 2, 2)　μ(t) : (B, D, M)&lt;br&gt;另存：各专家均值 xe、门控用的 gate_c / gate_y / gate_S / gate_V" vertex="1">
          <mxGeometry height="100" width="800" x="850" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c8" value="μ_{k|i}">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c9" value="X̃_CV">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c10" value="X̃_CA">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="825" y="372" />
              <mxPoint x="825" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="c10" value="h, 特征历史">
          <mxGeometry relative="1" as="geometry">
