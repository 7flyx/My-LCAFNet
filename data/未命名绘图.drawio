        <mxCell id="c25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="经典合作方输出 x₂, P₂&lt;br&gt;（同一测试数据上运行）" vertex="1">
