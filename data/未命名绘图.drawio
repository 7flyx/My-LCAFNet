        <mxCell id="c26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;混合层（第 7 页）&lt;/b&gt;&lt;br&gt;w 为 MM-BKN 的权重（位置、速度各一个）：固定权重或 GBM 逐步权重&lt;br&gt;x = w·x₁ + (1−w)·x₂；协方差 mix 或 mm+shift&lt;br&gt;防护：两者差异 d² &gt; 13.8 时只用 MM-BKN&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;fusion/hybrid.py: build_rows / apply_layer&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="1030" y="260" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;统一协方差校准（第 8 页）&lt;/b&gt;&lt;br&gt;每个方法（MM-BKN、经典、混合）的输出协方差都在同一验证集上做逐分量尺度校准 κ_p, κ_v&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval_fusion.py: cov_scale / apply_cov_scale&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="620" x="1030" y="450" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;指标与检验&lt;/b&gt;&lt;br&gt;精度：位置 / 速度 MSE（dB）&lt;br&gt;不确定性：NLL、ANEES、95% 覆盖率；机动开始 0–9 步、持续段 2–9 步&lt;br&gt;显著性：配对 bootstrap（半实测按飞机聚类）&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval/metrics.py · scripts/bootstrap_sig.py · hybrid_report.py&lt;/font&gt;" vertex="1">
