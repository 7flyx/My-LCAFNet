          </mxGeometry>
        </mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5058;fontSize=11;labelBackgroundColor=#FFFFFF;" target="c10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;冻结层&lt;/b&gt;（--hybrid-freeze-from）&lt;br&gt;build_rows 返回 layer（合作方及其调参、k₁、k₂、固定权重、GBM、协方差方式、最终尺度），apply_layer 把它原样用到之后的切分（如 S-C 拟合 → S-E 测试），检验整套方法对未见转弯的泛化。" vertex="1">
          <mxGeometry height="340" width="330" x="1340" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;align=left;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;审核要点&lt;/b&gt;&lt;br&gt;1. w 是 MM-BKN 的权重：w = 1 即只用 MM-BKN。固定权重的公式是对 Σ(w·d − (truth − x₂))² 求最小，截断方向正确。&lt;br&gt;2. 防护触发时必须显式取 x₁、P₁（np.where），不能依赖 1·x₁ + 0·x₂：合作方为 NaN 时 0·NaN 仍是 NaN（2026-10-20 已修，tests/test_hybrid.py 覆盖）。&lt;br&gt;3. GBM 目标：旧版（clipped）先把 w* 截到 [0,1] 再回归，不等于融合 MSE；新版（mse）不截断目标、预测后再截断。clipped 仍可用于复现旧结果。&lt;br&gt;4. mix 协方差用标量 wc = (w_p + w_v)/2，而均值对 p、v 用不同权重：它是启发式公式，不是关于当前均值的精确矩匹配（审查报告 M1），论文里要如实命名。&lt;br&gt;5. 所有选择（合作方、权重、协方差方式、尺度）只用验证集或新种子数据；测试集只用于最终评价。" vertex="1">
          <mxGeometry height="300" width="1630" x="40" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
