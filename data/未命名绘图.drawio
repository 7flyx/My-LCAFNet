        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#3ade0d, #656565);fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#9E9E9E;arcSize=3;strokeWidth=2;" value="A 离线：数据与专家训练" vertex="1">
          <mxGeometry height="880" width="380" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fontColor=#1B2430;spacing=2;" value="&lt;b style=&#39;font-size:20px&#39;&gt;MM-BKN 与混合方法：整体数据流（离线训练 → 在线逐步滤波 → 混合层 → 评估）&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1600" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;数据生成&lt;/b&gt;&lt;br&gt;仿真轨迹（CV/CA 切换、野值、时变噪声）&lt;br&gt;OpenSky 航迹 + 仿真雷达噪声&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mmbkn/data/gen_traj.py · scripts/prep_opensky.py&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;两个 BKN 专家分别训练（互不相干）&lt;/b&gt;&lt;br&gt;CV 专家：只用匀速段数据，状态 4 维&lt;br&gt;CA 专家：匀加速 / 机动段，状态 6 维&lt;br&gt;损失 =(1−β)·MSE + β·Σ|e²−方差| + dropout 正则&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;scripts/train_bkn_vec.py · bkn/filter.py: bkn_loss&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;专家离线标定&lt;/b&gt;&lt;br&gt;在专家自己的验证集上单独运行：&lt;br&gt;方差校准 σ_p, σ_v（, σ_a）&lt;br&gt;标称新息方差 S_nom、稳健尺度 S_rob&lt;br&gt;p–v 相关收缩系数 γ&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval_fusion.py: Expert.calibrate&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;融合超参数选择&lt;/b&gt;&lt;br&gt;在目标场景验证集上按位置 MSE 网格搜索：&lt;br&gt;s_key（Ŝ 取法）、温度 τ、coupling、&lt;br&gt;交互方式 mix、stay&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval_fusion.py main(): STAGE_A / STAGE_B&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="&lt;b&gt;经典方法调参&lt;/b&gt;&lt;br&gt;经典 IMM（CV/CA，鲁棒、自适应、STF、CT/CT-EKF…）在同一验证集调参；&lt;br&gt;按验证集位置 MSE 选出“合作方”&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;eval/baselines.py: classical_methods&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="40" y="780" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="量测 y_t（只有位置 [p_x, p_y]）" vertex="1">
          <mxGeometry height="70" width="500" x="450" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="① 马尔可夫预测 c(t) = Πᵀ μ(t−1)，混合概率 μ_{k|i}&lt;br&gt;② 样本云交互：每个专家的 J 个样本整体平移（第 3 页）" vertex="1">
          <mxGeometry height="90" width="500" x="450" y="220" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="CV 专家 BKN 走一步&lt;br&gt;J 条 MC 链 → 4 维后验样本&lt;br&gt;（第 4 页）" vertex="1">
          <mxGeometry height="110" width="240" x="450" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="CA 专家 BKN 走一步&lt;br&gt;J 条 MC 链 → 6 维后验样本&lt;br&gt;（第 4 页）" vertex="1">
          <mxGeometry height="110" width="240" x="710" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="③ 新息似然 + 马尔可夫先验 → 模式概率 μ(t)（第 5 页）" vertex="1">
          <mxGeometry height="90" width="500" x="450" y="500" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="④ 每个专家：J 个样本 → [p,v] 均值与 2×2 协方差（标定、收缩）&lt;br&gt;⑤ 矩匹配：x̂ = Σμ m，P = Σμ (C + 分歧项)（第 6 页）" vertex="1">
          <mxGeometry height="90" width="500" x="450" y="630" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;align=center;verticalAlign=middle;spacing=6;arcSize=8;" value="MM-BKN 输出：x̂(t)（每轴 [p,v]）、P(t)（每轴 2×2）、μ(t)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;fusion/mm_runner.py: run_mm&lt;/font&gt;" vertex="1">
